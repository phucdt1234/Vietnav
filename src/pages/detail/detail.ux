<template>
  <div class="detail-page" @touchstart="onTouchStart" @touchmove="onTouchMove" @touchend="onTouchEnd">
    <div class="top-bar">
      <text class="title">Settings</text>
      <input class="close-btn" type="button" value="Back" onclick="goBack" />
    </div>

    <div class="setting-card">
      <text class="group-title">Display</text>
      <input class="setting-row" type="button" value="Minimal mode      {{ highContrast ? 'ON' : 'OFF' }}" onclick="toggleHighContrast" />
      <text class="hint" show="{{ highContrast }}">Double tap nav screen to exit minimal</text>
      <input class="setting-row" type="button" value="Screen            {{ screenMode }}" onclick="cycleScreenMode" />
      <input class="setting-row" type="button" value="Brightness        {{ brightnessPercent }}%" onclick="cycleBrightness" />
    </div>

    <div class="setting-card">
      <text class="group-title">Haptic</text>
      <input class="setting-row" type="button" value="Strength          {{ vibrationIntensity }}" onclick="cycleIntensity" />
      <input class="setting-row" type="button" value="Pattern           {{ vibrationPattern }}" onclick="cyclePattern" />
      <input class="test-row" type="button" value="Test haptic" onclick="testHaptic" />
    </div>

    <div class="setting-card">
      <text class="group-title">Sync</text>
      <input class="setting-row" type="button" value="Refresh           {{ refreshMode }}" onclick="cycleRefresh" />
      <input class="setting-row" type="button" value="Auto exit         {{ autoExitText }}" onclick="cycleAutoExit" />
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import app from "@system.app"
import interconnect from "@system.interconnect"
import vibrator from "@system.vibrator"
import {
  loadSettings,
  saveSettings,
  applyKeepScreenOn
} from "../../common/settings"

let connect = null

export default {
  private: {
    touchStartX: 0,
    touchStartY: 0,
    touchEndX: 0,
    touchEndY: 0,
    isTouching: false,
    highContrast: false,
    keepScreenOn: false,
    screenMode: "system",
    brightnessPercent: 70,
    vibrationIntensity: "medium",
    vibrationPattern: "smart",
    refreshMode: "realtime",
    autoExitMinutes: 10,
    autoExitText: "10m"
  },

  onInit() {
    this.bindInterconnect()
    this.loadUserSettings()
  },

  onShow() {
    this.loadUserSettings()
  },

  exitApp() {
    if (app && app.terminate) {
      app.terminate()
      return
    }
    router.back()
  },

  goBack() {
    router.back()
  },

  loadUserSettings() {
    loadSettings((settings) => {
      this.applySettings(settings, false)
    })
  },

  applySettings(settings, persist) {
    this.highContrast = settings.highContrast
    this.keepScreenOn = settings.keepScreenOn
    this.screenMode = settings.screenMode
    this.brightnessPercent = settings.brightnessPercent
    this.vibrationIntensity = settings.vibrationIntensity
    this.vibrationPattern = settings.vibrationPattern
    this.refreshMode = settings.refreshMode
    this.autoExitMinutes = settings.autoExitMinutes
    this.autoExitText = this.autoExitMinutes === 0 ? "off" : this.autoExitMinutes + "m"
    applyKeepScreenOn(this.screenMode, this.brightnessPercent)
    if (persist) {
      saveSettings(settings)
      this.sendConfig(settings)
    }
  },

  bindInterconnect() {
    try {
      connect = interconnect.instance()
    } catch (e) {
      console.log("settings interconnect fail " + e.message)
    }
  },

  sendConfig(settings) {
    if (!connect) return
    try {
      connect.send({
        data: {
          tag: "__cfg__",
          refreshMode: settings.refreshMode
        },
        fail: (data, code) => {
          console.log("config send fail " + code)
        }
      })
    } catch (e) {
      console.log("config send exception " + e.message)
    }
  },

  currentSettings() {
    return {
      highContrast: this.highContrast,
      keepScreenOn: this.screenMode !== "system",
      screenMode: this.screenMode,
      brightnessPercent: this.brightnessPercent,
      vibrationIntensity: this.vibrationIntensity,
      vibrationPattern: this.vibrationPattern,
      refreshMode: this.refreshMode,
      autoExitMinutes: this.autoExitMinutes
    }
  },

  toggleHighContrast() {
    const settings = this.currentSettings()
    settings.highContrast = !settings.highContrast
    this.applySettings(settings, true)
  },

  cycleScreenMode() {
    const settings = this.currentSettings()
    const order = ["system", "on", "auto"]
    const index = order.indexOf(settings.screenMode)
    settings.screenMode = order[(index + 1) % order.length]
    settings.keepScreenOn = settings.screenMode !== "system"
    this.applySettings(settings, true)
  },

  cycleBrightness() {
    const settings = this.currentSettings()
    settings.brightnessPercent = settings.brightnessPercent >= 100 ? 10 : settings.brightnessPercent + 10
    this.applySettings(settings, true)
  },

  cycleIntensity() {
    const order = ["strong", "medium", "light"]
    const settings = this.currentSettings()
    const index = order.indexOf(settings.vibrationIntensity)
    settings.vibrationIntensity = order[(index + 1) % order.length]
    this.applySettings(settings, true)
  },

  cyclePattern() {
    const order = ["smart", "long", "double"]
    const settings = this.currentSettings()
    const index = order.indexOf(settings.vibrationPattern)
    settings.vibrationPattern = order[(index + 1) % order.length]
    this.applySettings(settings, true)
  },

  cycleRefresh() {
    const settings = this.currentSettings()
    settings.refreshMode = settings.refreshMode === "realtime" ? "changes" : "realtime"
    this.applySettings(settings, true)
  },

  cycleAutoExit() {
    const order = [10, 5, 0]
    const settings = this.currentSettings()
    const index = order.indexOf(settings.autoExitMinutes)
    settings.autoExitMinutes = order[(index + 1) % order.length]
    this.applySettings(settings, true)
  },

  testHaptic() {
    const pattern = this.vibrationPattern === "double" ? "double" : this.vibrationPattern === "long" ? "long" : "single"
    const profile = this.resolveHapticProfile(this.vibrationPattern === "smart" ? "smart" : pattern, 55)
    for (let i = 0; i < profile.repeat; i++) {
      setTimeout(() => {
        vibrator.vibrate({
          mode: profile.mode,
          fail: (data, code) => {
            console.log("test vibrate fail " + code)
          }
        })
      }, i * profile.delay)
    }
  },

  resolveHapticProfile(pattern, meters) {
    if (pattern === "smart" && meters > 0) {
      return this.resolveSmartApproachProfile(meters)
    }

    const base = {
      strong: {
        mode: "long",
        repeat: 3,
        delay: 260
      },
      medium: {
        mode: "long",
        repeat: 1,
        delay: 0
      },
      light: {
        mode: "short",
        repeat: 1,
        delay: 0
      }
    }[this.vibrationIntensity] || {
      mode: "long",
      repeat: 1,
      delay: 0
    }

    if (pattern === "double") {
      base.repeat = Math.max(base.repeat, this.vibrationIntensity === "strong" ? 3 : 2)
      base.delay = 260
    }
    if (pattern === "long") {
      base.mode = "long"
      base.repeat = Math.max(base.repeat, this.vibrationIntensity === "strong" ? 3 : 1)
      base.delay = base.repeat > 1 ? 260 : 0
    }
    return base
  },

  resolveSmartApproachProfile(meters) {
    if (meters >= 200) {
      return {
        mode: "short",
        repeat: 1,
        delay: 0
      }
    }
    if (meters > 100) {
      return {
        mode: "short",
        repeat: this.vibrationIntensity === "strong" ? 2 : 1,
        delay: 260
      }
    }
    if (meters >= 90) {
      return {
        mode: "short",
        repeat: this.vibrationIntensity === "light" ? 1 : 2,
        delay: 280
      }
    }
    if (meters >= 80) {
      return {
        mode: "short",
        repeat: 2,
        delay: 230
      }
    }
    if (meters >= 70) {
      return {
        mode: "short",
        repeat: this.vibrationIntensity === "strong" ? 3 : 2,
        delay: 180
      }
    }
    if (meters >= 60) {
      return {
        mode: this.vibrationIntensity === "strong" ? "long" : "short",
        repeat: this.vibrationIntensity === "light" ? 3 : 4,
        delay: 110
      }
    }
    if (meters <= 5) {
      return {
        mode: "short",
        repeat: 0,
        delay: 0
      }
    }
    if (meters <= 25) {
      return {
        mode: "long",
        repeat: this.vibrationIntensity === "light" ? 2 : 4,
        delay: 90
      }
    }
    if (meters <= 50) {
      return {
        mode: "short",
        repeat: this.vibrationIntensity === "strong" ? 4 : 3,
        delay: 130
      }
    }
    if (meters <= 75) {
      return {
        mode: "short",
        repeat: this.vibrationIntensity === "light" ? 2 : 3,
        delay: 190
      }
    }
    return {
      mode: "short",
      repeat: this.vibrationIntensity === "light" ? 2 : 3,
      delay: 230
    }
  },

  onTouchStart(e) {
    if (!e || !e.touches || !e.touches[0]) return
    this.isTouching = true
    this.touchStartX = e.touches[0].clientX
    this.touchStartY = e.touches[0].clientY
    this.touchEndX = this.touchStartX
    this.touchEndY = this.touchStartY
  },

  onTouchMove(e) {
    if (!this.isTouching || !e || !e.touches || !e.touches[0]) return
    this.touchEndX = e.touches[0].clientX
    this.touchEndY = e.touches[0].clientY
  },

  onTouchEnd() {
    if (!this.isTouching) return
    this.isTouching = false
    const deltaX = this.touchEndX - this.touchStartX
    const deltaY = this.touchEndY - this.touchStartY
    if (deltaX > 50 && Math.abs(deltaX) > Math.abs(deltaY)) {
      this.exitApp()
    }
  }
}
</script>

<style src="../../common/style.css"></style>

<style>
.detail-page {
  width: 100%;
  height: 100%;
  background-color: #05070a;
  color: #ffffff;
  flex-direction: column;
  justify-content: flex-start;
  align-items: center;
  padding-left: 5px;
  padding-right: 5px;
  padding-top: 5px;
}

.top-bar {
  width: 96px;
  height: 18px;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2px;
}

.title {
  width: 50px;
  height: 16px;
  font-size: 12px;
  font-weight: bold;
  color: #ffffff;
}

.close-btn {
  width: 38px;
  height: 16px;
  border-radius: 5px;
  background-color: #263241;
  color: #ffffff;
  font-size: 8px;
  text-align: center;
}

.setting-card {
  width: 96px;
  border-radius: 7px;
  background-color: #101722;
  padding-left: 3px;
  padding-right: 3px;
  padding-top: 2px;
  padding-bottom: 2px;
  margin-top: 2px;
  flex-direction: column;
  align-items: center;
}

.group-title {
  width: 88px;
  height: 8px;
  font-size: 7px;
  color: #8fcbff;
  text-align: left;
}

.setting-row {
  width: 88px;
  height: 14px;
  border-radius: 5px;
  background-color: #1a2635;
  color: #ffffff;
  font-size: 7px;
  text-align: center;
  margin-top: 2px;
}

.test-row {
  width: 88px;
  height: 14px;
  border-radius: 5px;
  background-color: #224536;
  color: #d8ffe9;
  font-size: 7px;
  text-align: center;
  margin-top: 2px;
}

.hint {
  width: 88px;
  height: 8px;
  font-size: 7px;
  line-height: 7px;
  color: #aeb7c4;
  text-align: center;
  margin-top: 1px;
}
</style>
