  position: absolute;
  top: 7px;
  left: 18px;
  width: 66px;
  height: 24px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.status-text {
  width: 66px;
  height: 12px;
  font-size: 9px;
  color: #d7dde5;
  text-align: center;
}

