  width: 66px;
  height: 12px;
  font-size: 10px;
  color: #ffffff;
  text-align: center;
}

.turn-box {
  position: absolute;
  left: 0px;
  top: 35px;
  width: 106px;
  height: 92px;
  border-radius: 8px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.asset-preload {
  position: absolute;
  left: -200px;
  top: -200px;
  width: 1px;
  height: 1px;
}

.preload-img {
  width: 1px;
  height: 1px;
}

.turn-box-large {
  position: absolute;
  left: 0px;
  top: 36px;
  width: 106px;
  height: 106px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.icon-stack {
  width: 85px;
  height: 85px;
  align-items: center;
  justify-content: center;
}

.icon-stack-large {
  width: 100px;
  height: 100px;
  align-items: center;
  justify-content: center;
}

.turn-img {
  width: 85px;
  height: 85px;
  object-fit: contain;
}

.turn-img-large {
  width: 100px !important;
  height: 100px !important;
  object-fit: contain;
}

.distance {
  position: absolute;
  left: 5px;
  top: 128px;
  width: 96px;
  height: 25px;
  font-size: 22px;
  font-weight: bold;
  text-align: center;
  color: #ffffff;
  margin-top: 0px;
  margin-bottom: 0px;
}

.distance-large {
  position: absolute;
  left: 0px;
  top: 150px;
  width: 106px;
  height: 32px;
  font-size: 28px;
  margin-top: 0px;
  margin-bottom: 0px;
}

.street {
  position: absolute;
  left: 4px;
  top: 154px;
  width: 98px;
  height: 33px;
  font-size: 12px;
  line-height: 14px;
  text-align: center;
  color: #d7dde5;
}

.street-no-distance {
  top: 132px;
  height: 46px;
  font-size: 13px;
  line-height: 15px;
}

.hint {
  position: absolute;
  left: 5px;
  top: 188px;
  width: 96px;
  height: 11px;
  font-size: 8px;
  text-align: center;
  color: #7f8a99;
  margin-top: 0px;
}

.hint-no-distance {
  top: 181px;
  height: 12px;
  font-size: 9px;
}

.eta {
  position: absolute;
  left: 5px;
  top: 199px;
  width: 96px;
  height: 11px;
  font-size: 8px;
  text-align: center;
